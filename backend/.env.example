# Copy to backend/.env and adjust. Real environment variables take precedence.

APP_ENV=development
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: path to the built frontend (frontend/dist) to serve UI + API from one process.
# FRONTEND_DIST=../frontend/dist

# Upload & processing limits
MAX_UPLOAD_MB=50
MAX_VIDEO_DURATION_SECONDS=300
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=4
JOB_TIMEOUT_SECONDS=900
RATE_LIMIT_JOBS_PER_HOUR=20
# Set true only behind a trusted reverse proxy (Hugging Face, Render) so client IPs are read from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Whisper (runs locally — no API key needed)
# openai-whisper | faster-whisper | none
WHISPER_ENGINE=openai-whisper
WHISPER_MODEL=tiny
WHISPER_ALLOWED_MODELS=tiny,base
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# Where model weights are cached (defaults to ~/.cache/whisper)
# WHISPER_CACHE_DIR=./models

# auto | moviepy | ffmpeg
RENDER_ENGINE=auto

# Temporary storage & retention
TEMP_DIR=./tmp
JOB_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5
MIN_FREE_DISK_MB=500

LOG_LEVEL=INFO
# Shown on the About page
SOURCE_REPO_URL=

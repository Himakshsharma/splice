# Base URL of the SPLICE API, without a trailing slash.
# Leave empty when the UI and API are served from the same origin
# (local dev via the Vite proxy, or the single Hugging Face container).
# For a Vercel frontend + separate backend, set it to the backend URL, e.g.
# VITE_API_BASE_URL=https://splice-api.onrender.com
VITE_API_BASE_URL=

# Optional: link shown in the footer and About page.
VITE_SOURCE_REPO_URL=
